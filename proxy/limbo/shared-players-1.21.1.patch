@@ -0,0 +1,33 @@
+package com.loohp.limbo.network.protocol.packets;
+
+import com.loohp.limbo.registry.PacketRegistry;
+import com.loohp.limbo.utils.DataTypeIO;
+import com.loohp.limbo.location.Location;
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+
+public class PacketPlayOutEntityTeleport extends PacketOut {
+    private final int entityId;
+    private final Location location;
+
+    public PacketPlayOutEntityTeleport(int entityId, Location location) {
+        this.entityId = entityId;
+        this.location = location;
+    }
+
+    @Override
+    public byte[] serializePacket() throws IOException {
+        ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+        DataOutputStream output = new DataOutputStream(buffer);
+        DataTypeIO.writeVarInt(output, PacketRegistry.getPacketId(getClass()));
+        DataTypeIO.writeVarInt(output, entityId);
+        output.writeDouble(location.getX());
+        output.writeDouble(location.getY());
+        output.writeDouble(location.getZ());
+        output.writeByte((int) (location.getYaw() * 256.0F / 360.0F));
+        output.writeByte((int) (location.getPitch() * 256.0F / 360.0F));
+        output.writeBoolean(false);
+        return buffer.toByteArray();
+    }
+}
