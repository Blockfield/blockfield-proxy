# Limbo под 1.21.1 (0.7.10) в апстриме заморожен, а фикс холостого цикла asyncTasksQueue (~50% CPU без игроков)
# есть только в master под новые версии игры — собираем 1.21.1 сами с бэкпортом (proxy/limbo/*.patch).
# Limbo не шлёт время суток, и клиент сам уводил лобби в ночь: fixed-day задаёт overworld fixed_time (полдень).
# biome-registry выбирает биом по имени: числовой ID зависит от порядка ресурсов в JAR и может давать тёмное небо End.
# База limbo закреплена по digest (тот же, из которого собран v2.54.1): плавающий тег менял бы сборку без правки здесь.
# Обновление — отдельным PR с новым digest тега 3.9-eclipse-temurin-21.
FROM maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS limbo
RUN git clone -q https://github.com/LOOHP/Limbo /src && cd /src && git checkout -q 29571119f9df6737b5025b9ff1207e49b90cac82
COPY proxy/limbo/*.patch /tmp/limbo-patches/
RUN cd /src && git apply /tmp/limbo-patches/*.patch && mvn -q -B -DskipTests package

# База прокси закреплена по digest (тот же, из которого собран v2.54.1): плавающий java21 менял бы рантайм без правки здесь.
# Обновление — отдельным PR с новым digest тега java21.
FROM itzg/mc-proxy:java21@sha256:e65f52bd44a223181a62c3516d5bbdff7ec185ec527bf43e98175d74290ec94f AS runtime-base
LABEL org.opencontainers.image.source="https://github.com/Blockfield/blockfield-proxy"
ENV TYPE=VELOCITY VELOCITY_VERSION=3.5.1 VELOCITY_BUILD_ID=615 MEMORY=256m
# No JVM_OPTS default: start-proxy.sh appends the RakNet port flags from
# BLOCKFIELD_RAKNET_GAME_PORT/_WORKSHOP_PORT (defaults 25566/25567) at
# container start, so extra Dokploy JVM_OPTS can never drop the ports.
ADD --checksum=sha256:b03cebc45c1583edf8c7456fa67f0a6248eb95a856249378173cc1ea8b8d0d68 \
    https://cdn.modrinth.com/data/9eGKb6K1/versions/ES87t4lm/voicechat-velocity-2.6.18.jar /plugins/voicechat-velocity-2.6.18.jar
# Blockfield fork (bf3): upstream 76ab30a + SYNC FrameData release fix + second RakNet
# UDP port for the Workshop profile. Upstream Modrinth jar has no second port.
ADD --checksum=sha256:d8a609bf562d20fbd98d50e9b4c32ffce7b8b51d413b6dc9418af2fd8d07273e \
    https://github.com/Blockfield/raknetify/releases/download/bf3/raknetify-velocity-0.1.0+alpha.5.1-bf3-all.jar /plugins/raknetify-velocity-0.1.0+alpha.5.1-bf3-all.jar
COPY proxy/plugin/build/libs/blockfield-proxy-1.0.0.jar /plugins/blockfield-proxy.jar
COPY proxy/velocity.toml /config/velocity.toml
COPY proxy/lobby/ /opt/lobby/
RUN chown -R 1000:1000 /opt/lobby
COPY --chmod=755 proxy/start-proxy.sh /start-blockfield-proxy
COPY --chmod=644 proxy/raknet-ports.sh /opt/proxy/raknet-ports.sh
EXPOSE 25565/tcp 25565/udp 25566/udp 25567/udp
CMD ["/start-blockfield-proxy"]

# CI consumes both Java outputs checked in the same job.
FROM runtime-base AS ci
COPY --chown=1000:1000 proxy/limbo-build/Limbo-0.7.10-ALPHA-1.21.1.jar /opt/lobby/limbo.jar

FROM runtime-base AS runtime
COPY --from=limbo --chown=1000:1000 /src/target/Limbo-0.7.10-ALPHA-1.21.1.jar /opt/lobby/limbo.jar
